---
import { ArrowRight } from 'lucide-react'
import { urlFor } from '../lib/sanity'

interface Props {
  finalCta: {
    heading: string
    description?: string
    backgroundImage?: {
      asset: {
        _ref: string
      }
    }
    cta: {
      label: string
      url: string
      icon?: string
      openInNewTab?: boolean
    }
  }
}

const { finalCta } = Astro.props
---

<section class="final-cta">
  {finalCta.backgroundImage && (
    <img
      class="final-cta__background"
      src={urlFor(finalCta.backgroundImage).width(2000).quality(85).url()}
      alt=""
      aria-hidden="true"
    />
  )}

  <div class="final-cta__overlay"></div>

  <div class="final-cta__content">
    <h2>{finalCta.heading}</h2>

    {finalCta.description && (
      <p>{finalCta.description}</p>
    )}

    <a
      class="final-cta__button"
      href={finalCta.cta.url}
      target={finalCta.cta.openInNewTab ? '_blank' : undefined}
      rel={
        finalCta.cta.openInNewTab
          ? 'noopener noreferrer'
          : undefined
      }
    >
      <span>{finalCta.cta.label}</span>

      {(!finalCta.cta.icon || finalCta.cta.icon === 'arrow-right') && (
        <span class="final-cta__icon" aria-hidden="true">
          <ArrowRight size={20} strokeWidth={1.8} />
        </span>
      )}
    </a>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    width: 100%;
    min-height: 210px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
  }

  .final-cta__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final-cta__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 28, 55, 0.72);
  }

  .final-cta__content {
    position: relative;
    z-index: 1;
    width: min(1100px, calc(100% - 48px));
    padding: 55px 0;
    text-align: center;
    color: #ffffff;
  }

  .final-cta h2 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 600;
  }

  .final-cta p {
    max-width: 820px;
    margin: 25px auto 0;
    color: #ffffff;
    font-size: 17px;
    font-weight: 100;
  }

  .final-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 50px;
    padding: 12px 28px;
    border-radius: 999px;
    background: #004d84;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 35, 70, 0.25);
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .final-cta__button:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 35, 70, 0.32);
  }

  .final-cta__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }

  .final-cta__button:hover .final-cta__icon {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .final-cta {
      min-height: 280px;
    }

    .final-cta__content {
      padding: 50px 0;
    }

    .final-cta h2 {
      font-size: 32px;
    }
  }

  @media (max-width: 600px) {
    .final-cta {
      min-height: 300px;
    }

    .final-cta__content {
      width: calc(100% - 40px);
      padding: 45px 0;
    }

    .final-cta h2 {
      font-size: 28px;
    }

    .final-cta p {
      margin-top: 18px;
      font-size: 15px;
    }

    .final-cta__button {
      margin-top: 24px;
      padding: 12px 24px;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta__icon {
      transition: none;
    }
  }
</style>