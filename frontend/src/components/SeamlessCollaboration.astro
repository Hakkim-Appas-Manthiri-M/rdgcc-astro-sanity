---
import { urlFor } from '../lib/sanity'

interface CollaborationItem {
  title: string
  description: string
  image: {
    asset: {
      _ref: string
    }
  }
  alt: string
}

interface Props {
  seamlessCollaboration: {
    heading: string
    description?: string
    items: CollaborationItem[]
  }
}

const { seamlessCollaboration } = Astro.props
---

<section class="seamless-collaboration">
  <div class="seamless-collaboration__container">

    <header class="seamless-collaboration__header">
      <h2>{seamlessCollaboration.heading}</h2>

      {seamlessCollaboration.description && (
        <p>{seamlessCollaboration.description}</p>
      )}
    </header>

    <div class="collaboration-grid">
      {seamlessCollaboration.items.map((item, index) => (
        <article class="collaboration-card">
          <div class="collaboration-card__image">
            <img
              src={urlFor(item.image).url()}
              alt={item.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>

          <div class="collaboration-card__content">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .seamless-collaboration {
    width: 100%;
    padding: 90px 0 120px;
    background: #ffffff;
    font-family: var(--font-body);
    overflow: hidden;
  }

  .seamless-collaboration__container {
    width: min(1080px, calc(100% - 60px));
    margin: 0 auto;
  }

  .seamless-collaboration__header {
    max-width: 850px;
    margin: 0 auto 90px;
    text-align: center;
  }

  .seamless-collaboration__header h2 {
    margin: 0;
    color: #004681;
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.8px;
  }

  .seamless-collaboration__header p {
    max-width: 760px;
    margin: 24px auto 0;
    color: #171717;
    font-size: 16px;
    font-weight: 200;
    line-height: 1.7;
    letter-spacing: -0.2px;
  }

  .collaboration-grid {
    display: flex;
    flex-direction: column;
    gap: 85px;
  }

  .collaboration-card {
    display: grid;
    grid-template-columns: 310px minmax(0, 1fr);
    column-gap: 65px;
    align-items: center;
    width: 100%;
  }

  .collaboration-card:nth-child(even) {
    grid-template-columns: minmax(0, 1fr) 310px;
  }

  .collaboration-card:nth-child(even)
  .collaboration-card__image {
    grid-column: 2;
    grid-row: 1;
  }

  .collaboration-card:nth-child(even)
  .collaboration-card__content {
    grid-column: 1;
    grid-row: 1;
    text-align: center;
  }

  .collaboration-card__image {
    position: relative;
    width: 290px;
    height: 290px;
    margin: 0;
    overflow: hidden;
    border-radius: 50%;
    background: #f1f3f5;
    box-shadow: 
        0 20px 24px -14px rgba(30, 60, 90, 0.42), 
        0 8px 14px -10px rgba(30, 60, 90, 0.18);
    clip-path: circle(50% at 50% 50%);
    isolation: isolate;
  }

  .collaboration-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    clip-path: circle(50% at 50% 50%);
    transform: scale(1);
    transform-origin: center center;
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collaboration-card__image:hover img{
    transform: scale(1.04);
  }

  .collaboration-card__content {
    max-width: 700px;
    text-align: left;
  }

  .collaboration-card__content h3 {
    margin: 0;
    color: #004681;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.2px;
  }

  .collaboration-card__content p {
    max-width: 700px;
    margin: 20px 0 0;
    color: #171717;
    font-size: 16px;
    font-weight: 200;
    line-height: 1.6;
  }


  @media (max-width: 1100px) {
    .seamless-collaboration {
      padding: 85px 0 105px;
    }

    .seamless-collaboration__container {
      width: calc(100% - 80px);
      max-width: 900px;
    }

    .seamless-collaboration__header {
      margin-bottom: 80px;
    }

    .seamless-collaboration__header h2 {
      font-size: 38px;
    }

    .seamless-collaboration__header p {
      font-size: 17px;
    }

    .collaboration-grid {
      gap: 95px;
    }

    .collaboration-card {
      grid-template-columns: 310px minmax(0, 1fr);
      column-gap: 55px;
    }

    .collaboration-card:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) 310px;
    }

    .collaboration-card__image {
      width: 310px;
      height: 310px;
      box-shadow: 
        0 20px 24px -14px rgba(30, 60, 90, 0.42),
        0 8px 14px -10px rgba(30, 60, 90, 0.18);
    }

    .collaboration-card__content h3 {
      font-size: 22px;
    }

    .collaboration-card__content p {
      font-size: 16px;
      line-height: 1.6;
    }

    .collaboration-card:nth-child(even)
    .collaboration-card__content {
      text-align: center;
    }
  }


  @media (max-width: 700px) {
    .seamless-collaboration {
      padding: 70px 0 85px;
    }

    .seamless-collaboration__container {
      width: calc(100% - 50px);
      max-width: none;
    }

    .seamless-collaboration__header {
      margin-bottom: 65px;
    }

    .seamless-collaboration__header h2 {
      font-size: 29px;
      line-height: 1.25;
      letter-spacing: -0.4px;
    }

    .seamless-collaboration__header p {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.6;
    }

    .collaboration-grid {
      gap: 90px;
    }

    .collaboration-card,
    .collaboration-card:nth-child(even) {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }


    .collaboration-card__image,
    .collaboration-card:nth-child(even)
    .collaboration-card__image {
      order: 1;
      width: 310px;
      height: 310px;
      box-shadow:
        0 20px 24px -14px rgba(30, 60, 90, 0.42),
        0 8px 14px -10px rgba(30, 60, 90, 0.18);
      margin: 0 auto 48px;
      flex-shrink: 0;
    }

    .collaboration-card__content,
    .collaboration-card:nth-child(even)
    .collaboration-card__content {
      order: 2;
      width: 100%;
      max-width: none;
      margin: 0;
      text-align: left;
    }

    .collaboration-card__content h3 {
      font-size: 22px;
      line-height: 1.32;
    }

    .collaboration-card__content p {
      max-width: none;
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.6;
    }
  }


  @media (max-width: 360px) {
    .seamless-collaboration__container {
      width: calc(100% - 40px);
    }

    .collaboration-card__image,
    .collaboration-card:nth-child(even)
    .collaboration-card__image {
      width: 285px;
      height: 285px;
    }

    .collaboration-card__content h3 {
      font-size: 21px;
    }

    .collaboration-card__content p {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collaboration-card__image img {
      transition: none;
    }
  }
</style>