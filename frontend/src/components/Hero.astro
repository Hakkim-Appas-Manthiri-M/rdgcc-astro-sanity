---
import { ArrowRight } from 'lucide-react'

interface Props {
  hero: {
    eyebrow?: string
    heading: string
    description?: string
    cta?: {
      label: string
      url: string
      icon?: string
      openInNewTab?: boolean
    }
  }
}

const { hero } = Astro.props
---

<section class="hero">
  <div class="hero__content">
    {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}

    <h1>{hero.heading}</h1>

    {hero.description && (
      <p class="description">{hero.description}</p>
    )}

    {hero.cta && (
      <a
        class="cta"
        href={hero.cta.url}
        target={hero.cta.openInNewTab ? '_blank' : undefined}
        rel={
          hero.cta.openInNewTab
            ? 'noopener noreferrer'
            : undefined
        }
      >
        <span>{hero.cta.label}</span>

        {(!hero.cta.icon || hero.cta.icon === 'arrow-right') && (
          <span class="cta__icon" aria-hidden="true">
            <ArrowRight size={19} strokeWidth={1.8} />
          </span>
        )}
      </a>
    )}
  </div>

  <div class="visual" aria-hidden="true">
    <div class="panel"></div>
    <div class="shape shape--top"></div>
    <div class="shape shape--bottom"></div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 60px;

    width: 100%;
    min-height: 645px;
    box-sizing: border-box;
    margin: 0;
    padding: 30px 125px;

    background: #f8fafc;
    font-family: var(--font-body);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  h1 {
    margin: 0;
    color: #004681;
    font-family: var(--font-heading);
    font-size: clamp(50px, 5vw, 46px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 1px;
  }

  .eyebrow {
    margin: 0 0 15px;
    color: #004681;
    font-size: 14px;
    font-weight: 600;
  }

  .description {
    max-width: 680px;
    margin: 28px 0 0;
    color: #202020;
    font-size: 17px;
    line-height: 1.65;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;

    margin-top: 34px;
    padding: 13px 28px;

    border-radius: 50px;
    background: #004681;
    color: #fff;

    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;

    box-shadow: 0 8px 20px rgb(7 85 138 / 18%);

    transition:
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cta:hover {
    background: #004681;
    box-shadow: 0 10px 24px rgb(7 85 138 / 22%);
  }

  .cta__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .cta:hover .cta__icon {
    transform: translateX(5px);
  }

  .cta:focus-visible {
    outline: 3px solid rgb(7 85 138 / 30%);
    outline-offset: 4px;
  }

  .visual {
    position: relative;
    height: 500px;
  }

  .panel {
    position: absolute;
    inset: 50px 60px 40px;
    border-radius: 25px;
    background: #e9eef4;
  }

  .panel::after {
    content: "";
    position: absolute;
    inset: 40px;
    border-radius: 22px;
    background: #dfe6ee;
  }

  .shape {
    position: absolute;
    border-radius: 22px;
  }

  .shape--top {
    top: 0;
    right: 0;
    width: 170px;
    height: 170px;
    background: #aaa;
  }

  .shape--bottom {
    bottom: 0;
    left: 0;
    width: 170px;
    height: 170px;
    background: #4b82aa;
  }

 @media (max-width: 1100px) and (min-width: 901px) {
  .hero {
    min-height: 407px;
    padding: 25px 50px 40px;
    gap: 35px;
  }

  .visual {
    height: 400px;
  }

  .panel {
    inset: 55px 45px 30px;
  }

  .shape--top,
  .shape--bottom {
    width: 135px;
    height: 135px;
  }
}

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 35px 40px 60px;
    }

    h1 {
      font-size: 50px;
      letter-spacing: -1.5px;
    }

    .description {
      font-size: 20px;
    }

    .visual {
      height: 600px;
    }

    .panel {
      inset: 55px 70px 30px;
    }

    .shape--top,
    .shape--bottom {
      width: 200px;
      height: 200px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      display: block;
      padding: 30px 20px 60px;
    }

    h1 {
      font-size: 40px;
      letter-spacing: -1.5px;
    }

    .description {
      font-size: 16px;
    }

    .visual {
      display: none;
    }
  }
</style>