---
interface Props {
  trackRecord: {
    eyebrow?: string
    heading: string
    stats: {
      value: string
      label: string
    }[]
  }
}

const { trackRecord } = Astro.props
---

<section class="track-record">
  <div class="track-record__intro">
    {trackRecord.eyebrow && (
      <p class="eyebrow">{trackRecord.eyebrow}</p>
    )}

    <h2>{trackRecord.heading}</h2>
  </div>

  <div class="stats">
    {trackRecord.stats.map((stat) => (
      <div class="stat">
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .track-record {
    display: grid;
    grid-template-columns: 0.8fr 1.6fr;
    align-items: center;    
    gap: 55px;
    padding: 70px 11%;
    background: #e9e9e9;
    font-family: var(--font-body);
  }

  .eyebrow {
    margin: 0 0 20px;
    color: #004681;
    font-family: var(--font-heading);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.1;
  }

  h2 {
    max-width: 360px;
    margin: 0;
    color: #202020;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: between;
    min-height: 245px;
    padding: 50px 30px;
    border-radius: 16px;
    background: #fff;
    text-align: center;
  }

  .stat strong {
    color: #004681;
    font-family: var(--font-heading);
    font-size: 62px;
    font-weight: 800;
    line-height: 1;
  }

  .stat span {
    max-width: 180px;
    margin-top: 18px;
    color: #667085;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .track-record {
      grid-template-columns: 0.8fr 1.6fr;
      gap: 45px;
      padding: 70px 3%;
    }

    .stats {
      gap: 20px;
    }

    .stat {
      min-height: 220px;
      padding: 35px 15px;
    }

    .stat strong {
      font-size: 52px;
    }
    
    .stat span {
      font-size: 17px;
    }
  }

  @media (max-width: 900px) {
    .track-record {
      grid-template-columns: 1fr;
      gap: 55px;
      padding: 70px 40px;
      text-align: center;
    }

    .track-record__intro {
      margin: 0 auto;
    }

    .eyebrow,
    h2 {
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .stats {
      gap: 20px;
    }

    .stat {
      min-height: 200px;
    }

    .stat strong {
      font-size: 52px;
    }

    .stat span {
      font-size: 17px;
    }
  }

  @media (max-width: 600px) {
    .track-record {
      display: block;
      padding: 65px 28px 70px;
      text-align: center;
    }

    .eyebrow {
      font-size: 32px;
      margin-bottom: 18px;
    }

    .h2{
      max-width: 340px;
      margin: 0 auto;
      font-size: 17px;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      margin-top: 55px;
    }

    .stat {
      min-height: 150px;
      padding: 20px 10px;
      border-radius: 0;
      background: transparent;
    }

    .stat strong {
      font-size: 42px;
    }

    .stat span {
      margin-top: 18px;
      font-size: 17px;
    }

    .stat:last-child {
      grid-column: 1 / -1;
    }
  }
</style>