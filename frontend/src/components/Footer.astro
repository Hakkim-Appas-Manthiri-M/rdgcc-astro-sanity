---
import { Mail, Phone, MapPin } from 'lucide-react'
import { FaLinkedinIn, FaFacebookF, FaWhatsapp } from 'react-icons/fa'
import { urlFor } from '../lib/sanity'

interface FooterLink {
  label: string
  url?: string
}

interface SocialLink {
  platform: string
  url: string
}

interface Props {
  footer: {
    logo: {
      asset: {
        _ref: string
      }
    }
    description: string
    partnerBadge?: {
      asset: {
        _ref: string
      }
    }
    services?: FooterLink[]
    companyLinks?: FooterLink[]
    successStories?: FooterLink[]
    contact?: {
      email?: string
      phone?: string
      address?: string
    }
    socialLinks?: SocialLink[]
    privacyUrl?: string
    termsUrl?: string
    copyright: string
  }
}

const { footer } = Astro.props

const socialLabel = (platform: string) => {
  switch (platform) {
    case 'linkedin':
      return 'LinkedIn'
    case 'facebook':
      return 'Facebook'
    case 'whatsapp':
      return 'WhatsApp'
    default:
      return platform
  }
}
---

<footer class="footer">
  <div class="footer__container">

    <div class="footer__grid">

      <div class="footer__company">
        <span class="footer__logo" aria-label="RightDirect Footer Logo">
            <img
              src={urlFor(footer.logo).width(220).url()}
              alt="RightDirect"
            />
        </span>

        <p class="footer__description">
          {footer.description}
        </p>

        {footer.partnerBadge && (
          <div class="footer__partner">
            <img
              src={urlFor(footer.partnerBadge).width(140).url()}
              alt="Google Partner"
              loading="lazy"
            />
            <span class="footer__partner-overlay" aria-hidden="true"></span>
          </div>
        )}
      </div>

      <div class="footer__column">
        <h2>Services</h2>

        {footer.services && (
          <ul>
            {footer.services.map((item) => (
              <li>
                <a href={item.url || '#'}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="footer__column footer__column--company">
        <h2>Company</h2>

        {footer.companyLinks && (
          <ul>
            {footer.companyLinks.map((item) => (
              <li>
                <a href={item.url || '#'}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="footer__column footer__column--stories">
        <h2>Success Stories</h2>

        {footer.successStories && (
          <ul>
            {footer.successStories.map((item) => (
              <li>
                <a href={item.url || '#'}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="footer__contact">
        <h2>Contact</h2>

        {footer.contact?.email && (
          <a
            class="footer__contact-item"
            href={`mailto:${footer.contact.email}`}
          >
            <span class="footer__contact-icon">
              <Mail size={17} strokeWidth={1.6} />
            </span>

            <span>{footer.contact.email}</span>
          </a>
        )}

        {footer.contact?.phone && (
          <a
            class="footer__contact-item"
            href={`tel:${footer.contact.phone.replace(/\s/g, '')}`}
          >
            <span class="footer__contact-icon">
              <Phone size={17} strokeWidth={1.6} />
            </span>

            <span>{footer.contact.phone}</span>
          </a>
        )}

        {footer.contact?.address && (
          <div class="footer__contact-item footer__contact-item--address">
            <span class="footer__contact-icon">
              <MapPin size={17} strokeWidth={1.6} />
            </span>

            <span>{footer.contact.address}</span>
          </div>
        )}

        {footer.socialLinks && footer.socialLinks.length > 0 && (
          <div class="footer__social">
            <p>Follow Us</p>

            <div class="footer__social-list">
              {footer.socialLinks.map((social) => (
                <a
                  href={social.url}
                  aria-label={socialLabel(social.platform)}
                  class={`footer__social-link footer__social-link--${social.platform}`}
                >
                  {social.platform === 'linkedin' && <FaLinkedinIn size={17} />}
                  {social.platform === 'facebook' && <FaFacebookF size={17} />}
                  {social.platform === 'whatsapp' && <FaWhatsapp size={18} />}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        {footer.privacyUrl && (
          <a href={footer.privacyUrl}>
            Privacy Policy
          </a>
        )}

        {footer.termsUrl && (
          <a href={footer.termsUrl}>
            Terms & Conditions
          </a>
        )}
      </div>

      <p class="footer__copyright">
        {footer.copyright}
      </p>
    </div>

  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background: #004681;
    color: #ffffff;
    font-family: var(--font-body);
  }

  .footer__container {
    width: min(1240px, calc(100% - 80px));
    margin: 0 auto;
    padding: 70px 0 28px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns:
      minmax(220px, 1.45fr)
      minmax(150px, 0.9fr)
      minmax(120px, 0.75fr)
      minmax(180px, 1fr)
      minmax(270px, 1.35fr);
    gap: 45px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: 190px;
    height: 58px;
    margin-bottom: 26px;
    text-decoration: none;
    transition: none;
  }

  .footer__logo:hover {
    transition: none;
    filter: none;
  }

  .footer__logo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 58px;
    object-fit: contain;
    object-position: left center;
    transition: none;
  }

  .footer__description {
    max-width: 285px;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    line-height: 1.8;
  }

  .footer__partner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 66px;
    margin-top: 25px;
    overflow: hidden;
    background: #ffffff;
    border-radius: 1px;
  }

  .footer__partner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.35s ease;
  }

  .footer__partner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.42);
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .footer__partner:hover .footer__partner-overlay {
    opacity: 0;
  }

  .footer__column h2,
  .footer__contact h2 {
    margin: 0 0 25px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .footer__column ul {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__column a {
    color: rgba(255, 255, 255, 0.82);
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .footer__column a:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  .footer__contact {
    padding-left: 34px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 22px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 14px;
    line-height: 1.7;
    text-decoration: none;
  }

  .footer__contact-item--address {
    margin-bottom: 27px;
  }

  .footer__contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
  }

  .footer__social {
    margin-top: 28px;
  }

  .footer__social p {
    margin: 0 0 14px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    letter-spacing: 3px;
  }

  .footer__social-list {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: #ffffff;
    text-decoration: none;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .footer__social-link:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.12);
  }

  .footer__social-link--linkedin:hover {
    background-color: #0a66c2;
    border-color: rgba(10, 102, 194, 0.55);
  }

  .footer__social-link--facebook:hover {
    background-color: #1877f2;
    border-color: rgba(24, 119, 242, 0.55);
  }

  .footer__social-link--whatsapp:hover {
    background-color: #25d366;
    border-color: rgba(37, 211, 102, 0.55);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 45px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  .footer__legal {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .footer__legal a,
  .footer__copyright {
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
    line-height: 1.5;
  }

  .footer__legal a {
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: #ffffff;
  }

  .footer__copyright {
    margin: 0;
    text-align: right;
  }

  @media (max-width: 1100px) {
    .footer__container {
      width: min(100% - 48px, 900px);
    }

    .footer__grid {
      grid-template-columns:
        1.35fr
        0.85fr
        0.75fr
        1fr
        1.25fr;
      gap: 24px;
    }

    .footer__contact {
      padding-left: 20px;
    }

    .footer__description {
      max-width: 210px;
    }
  }

  @media (max-width: 800px) {
    .footer__container {
      width: calc(100% - 52px);
      padding: 65px 0 28px;
    }

    .footer__grid {
      display: flex;
      flex-direction: column;
      gap: 52px;
    }

    .footer__company {
      padding-bottom: 8px;
    }

    .footer__description {
      max-width: 100%;
      font-size: 15px;
      line-height: 1.8;
    }

    .footer__column h2,
    .footer__contact h2 {
      margin-bottom: 22px;
      font-size: 18px;
    }

    .footer__column ul {
      gap: 16px;
    }

    .footer__column a,
    .footer__contact-item {
      font-size: 15px;
    }

    .footer__contact {
      padding-left: 20px;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: center;
      gap: 18px;
      margin-top: 45px;
      text-align: center;
    }

    .footer__copyright {
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    .footer__container {
      width: calc(100% - 50px);
      padding: 62px 0 30px;
    }

    .footer__grid {
      gap: 48px;
    }

    .footer__logo {
      margin-bottom: 24px;
    }

    .footer__partner {
      width: 84px;
      height: 84px;
      margin-top: 28px;
    }

    .footer__contact {
      padding-left: 20px;
    }

    .footer__contact-item {
      gap: 13px;
      margin-bottom: 24px;
      font-size: 15px;
      line-height: 1.75;
    }

    .footer__contact-icon {
      flex-basis: 36px;
    }

    .footer__social {
      margin-top: 32px;
    }

    .footer__social-list {
      gap: 12px;
    }

    .footer__social-link {
      width: 44px;
      height: 44px;
    }

    .footer__bottom {
      margin-top: 48px;
      padding-top: 24px;
    }

    .footer__legal {
      justify-content: center;
      gap: 24px;
    }

    .footer__legal a,
    .footer__copyright {
      font-size: 12px;
    }

    .footer__copyright {
      max-width: 300px;
      line-height: 1.7;
    }
  }
</style>